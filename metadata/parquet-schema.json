{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olo-labs/olo-testdata-nse-tl-data/blob/main/metadata/parquet-schema.json",
  "title": "NSE multi-timeframe TL Parquet row",
  "description": "Logical row schema for database/<group>/<symbol>/tl.parquet. The exporter mirrors all configured source columns; listed properties are common fields, not a closed list.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "daily_tl": {"type": ["number", "null"], "parquetType": "DOUBLE"},
    "daily_tl_ohlc": {"type": ["number", "null"], "parquetType": "DOUBLE"},
    "weekly_tl": {"type": ["number", "null"], "parquetType": "DOUBLE"},
    "weekly_tl_ohlc": {"type": ["number", "null"], "parquetType": "DOUBLE"},
    "monthly_tl": {"type": ["number", "null"], "parquetType": "DOUBLE"},
    "monthly_tl_ohlc": {"type": ["number", "null"], "parquetType": "DOUBLE"},
    "quarterly_tl": {"type": ["number", "null"], "parquetType": "DOUBLE"},
    "quarterly_tl_ohlc": {"type": ["number", "null"], "parquetType": "DOUBLE"},
    "candle_datetime": {"type": "string", "format": "date-time", "parquetType": "TIMESTAMP"},
    "daily_open": {"type": ["number", "null"], "parquetType": "DOUBLE"},
    "daily_high": {"type": ["number", "null"], "parquetType": "DOUBLE"},
    "daily_low": {"type": ["number", "null"], "parquetType": "DOUBLE"},
    "daily_close": {"type": ["number", "null"], "parquetType": "DOUBLE"},
    "daily_volume": {"type": ["number", "null"], "parquetType": "DOUBLE"}
  }
}
